# ==============================================================================
# wecom-forward-plus configuration — copy to `.env` and fill in real values.
# Never commit `.env`; it is ignored by git.
# ==============================================================================

# Dify API base URL (must include scheme; ends with /v1 for the default API).
WECOM_FORWARD_PLUS_DIFY_BASE_URL=https://your-dify.example.com/v1

# ------------------------------------------------------------------------------
# Global session defaults (apply to every group unless overridden).
# ------------------------------------------------------------------------------
# Seconds of inactivity after which a user's conversation is reset (5 minutes).
WECOM_FORWARD_PLUS_SESSION_TTL_SECONDS=300
# Per-group maximum number of active user sessions (LRU-evicted when exceeded).
WECOM_FORWARD_PLUS_SESSION_MAX_TOTAL=200
# Keywords that start a new conversation. JSON array or comma-separated.
WECOM_FORWARD_PLUS_SESSION_RESET_KEYWORDS=["开启新对话","重置对话","新一轮对话"]

# ------------------------------------------------------------------------------
# Configuration source: 'env' (default, groups come from the GROUP_ variables
# below) or 'database' (groups live in a PostgreSQL 'groups' table and are
# hot-reloaded at runtime; GROUP_* variables are then ignored entirely).
# ------------------------------------------------------------------------------
WECOM_FORWARD_PLUS_CONFIG_SOURCE=env

# PostgreSQL DSN — required only when CONFIG_SOURCE=database.
# Contains credentials: never logged, never committed.
WECOM_FORWARD_PLUS_DATABASE_URL=postgresql://user:password@localhost:5432/wecom

# How often (seconds, minimum 5) the running process re-reads the groups table.
WECOM_FORWARD_PLUS_DB_RELOAD_INTERVAL_SECONDS=30

# Password of the bundled PostgreSQL container (docker/docker-compose.yml).
# Paired with the DSN example: postgresql://wecom:<password>@postgres:5432/wecom
WECOM_POSTGRES_PASSWORD=change-me

# ------------------------------------------------------------------------------
# Group 1 — one WeCom robot paired with one Dify app API key.
# ------------------------------------------------------------------------------
# WeCom robot credentials are obtained from the Enterprise WeChat admin console
# (bot id + secret used by the wecom-aibot-python-sdk WebSocket connection).
WECOM_FORWARD_PLUS_GROUP_1_NAME=group-1
WECOM_FORWARD_PLUS_GROUP_1_WECOM_ROBOT_ID=your-robot-id-1
WECOM_FORWARD_PLUS_GROUP_1_WECOM_ROBOT_SECRET=your-robot-secret-1
WECOM_FORWARD_PLUS_GROUP_1_DIFY_API_KEY=app-your-dify-api-key-1
# Optional: override the global per-group session cap for this group.
WECOM_FORWARD_PLUS_GROUP_1_SESSION_MAX_TOTAL=300
# Optional: override the global conversation TTL for this group.
WECOM_FORWARD_PLUS_GROUP_1_SESSION_TTL_SECONDS=600

# ------------------------------------------------------------------------------
# Group 2 — add more groups by incrementing the index (must stay contiguous).
# ------------------------------------------------------------------------------
WECOM_FORWARD_PLUS_GROUP_2_NAME=group-2
WECOM_FORWARD_PLUS_GROUP_2_WECOM_ROBOT_ID=your-robot-id-2
WECOM_FORWARD_PLUS_GROUP_2_WECOM_ROBOT_SECRET=your-robot-secret-2
WECOM_FORWARD_PLUS_GROUP_2_DIFY_API_KEY=app-your-dify-api-key-2